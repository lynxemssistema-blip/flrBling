{
  "name": "bling-clientes-viewer",
  "version": "1.0.0",
  "description": "Visualizador de clientes integrado à API v3 do Bling no estilo oficial",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "powershell -Command \"Compress-Archive -Path 'server.js', 'package.json', 'package-lock.json', 'ecosystem.config.js', '.env', 'public', 'DEPLOY_HOSTINGER.md' -DestinationPath 'bling-clientes-flr.zip' -Force\"",
    "package": "npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3"
  }
}
