<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redireciona chamadas /api para o processo Node.js na porta 3000 (caso mod_proxy esteja ativo)
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

    # Fallback para rotas SPA se o arquivo não existir fisicamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
